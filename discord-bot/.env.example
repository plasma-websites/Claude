# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application ID (General Information page)
CLIENT_ID=
# Your server's ID (right-click server -> Copy Server ID, needs Developer Mode)
GUILD_ID=
# Channel where new orders are posted for orderers to accept
ORDERS_CHANNEL_ID=
# Role allowed to accept orders
ORDERER_ROLE_ID=
# Optional: max open (pending/accepted) orders per member, default 2
MAX_OPEN_ORDERS=2
# Optional: where orders are saved, default ./data/orders.json
DATA_FILE=
