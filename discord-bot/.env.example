# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application ID (General Information page)
CLIENT_ID=
# Your server's ID (right-click server -> Copy Server ID, needs Developer Mode)
GUILD_ID=

# Staff channel where new orders appear with the Accept button
STAFF_ORDERS_CHANNEL_ID=
# Role that can accept orders and handle order tickets. New orders ping this role
# (plus whoever is online). The bot prints the role's name at startup so you can check it.
ORDERER_ROLE_ID=
# Optional: trial orderer role. Trials can accept orders; the orderer role is pinged to
# supervise, and /trialpanel shows their successful orders. Accepted orderer applications get it.
TRIAL_ORDERER_ROLE_ID=
# Optional: category for tickets. If empty, the bot uses a category with "ticket" in its
# name, or creates a staff-only "🎫 Tickets" category.
TICKET_CATEGORY_ID=

# Optional: role that handles support tickets (defaults to ORDERER_ROLE_ID)
SUPPORT_ROLE_ID=
# Optional: category for support tickets (defaults to TICKET_CATEGORY_ID)
SUPPORT_CATEGORY_ID=
# Optional: channel where a "✅ order completed" post appears for every completed order
COMPLETED_CHANNEL_ID=
# Optional: vouch channel (controlled vouches with a sticky panel)
VOUCH_CHANNEL_ID=
# Optional: your RestoreCord / VaultCord verify link, used by /verifypanel
VERIFY_URL=
# Optional: if set, members need this role (given by RestoreCord / VaultCord) to order
VERIFIED_ROLE_ID=
# Optional: Claude API key for the AI (support assistant + chat bot)
# (https://console.anthropic.com → API keys). Leave empty to turn the AI off.
ANTHROPIC_API_KEY=
# Optional: channels where people can chat with Food Hub (comma-separated IDs)
CHAT_CHANNEL_IDS=
# Optional: max AI replies per day across the server (default 1000)
AI_DAILY_LIMIT=
# Optional: hours after "Complete order" before the ticket is deleted (default 2).
# A transcript is saved first; staff search them with /transcriptpanel.
AUTO_DELETE_HOURS=2
# Optional: max open orders per member (default 2)
MAX_OPEN_ORDERS=2
# Optional: where orders, screenshots and transcripts are saved (default ./data)
DATA_DIR=
# Optional: channel where orderer / partner applications are posted (default: staff orders channel)
APPLICATIONS_CHANNEL_ID=
# Optional: timezone for staff schedules (default Europe/London)
TIMEZONE=Europe/London
# Optional: the one colour every panel uses, as a hex code (default #5865F2, Discord blurple)
BRAND_COLOR=
