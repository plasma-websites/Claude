# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application ID (General Information page)
CLIENT_ID=
# Your server's ID (right-click server -> Copy Server ID, needs Developer Mode)
GUILD_ID=

# Staff channel where new orders appear with the Accept button
STAFF_ORDERS_CHANNEL_ID=
# Role that can accept orders and handle order tickets
ORDERER_ROLE_ID=
# Optional: category for tickets. If empty, the bot uses a category with "ticket" in its
# name, or creates a staff-only "🎫 Tickets" category.
TICKET_CATEGORY_ID=

# Optional: role that handles support tickets (defaults to ORDERER_ROLE_ID)
SUPPORT_ROLE_ID=
# Optional: category for support tickets (defaults to TICKET_CATEGORY_ID)
SUPPORT_CATEGORY_ID=
# Optional: channel where a "✅ order completed" post appears for every completed order
COMPLETED_CHANNEL_ID=
# Optional: vouch channel (controlled vouches with a sticky panel)
VOUCH_CHANNEL_ID=
# Optional: your RestoreCord / VaultCord verify link, used by /verifypanel
VERIFY_URL=
# Optional: if set, members need this role (given by RestoreCord / VaultCord) to order
VERIFIED_ROLE_ID=
# Optional: hours after "Complete order" before the ticket closes (default 2)
AUTO_CLOSE_HOURS=2
# Optional: max open orders per member (default 2)
MAX_OPEN_ORDERS=2
# Optional: where orders and screenshots are saved (default ./data)
DATA_DIR=
