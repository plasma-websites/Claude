# --- Our server ---
PORT=3000
SESSION_TTL_MS=1800000
# Max new accounts one client IP may create per hour (abuse guard)
MAX_REGISTRATIONS_PER_HOUR=3

# --- Uber partner integration (values come from your Uber agreement/docs) ---
UBER_BASE_URL=http://localhost:4000
UBER_PARTNER_KEY=dev-partner-key
UBER_PATH_ACCOUNT=/partner/v1/accounts
UBER_PATH_PROMO=/partner/v1/accounts/{accountId}/promos
UBER_PATH_RIDE=/partner/v1/accounts/{accountId}/rides
UBER_PATH_RIDE_STATUS=/partner/v1/rides/{rideId}

# Promo codes your agreement entitles users to (comma-separated). Max 3 applied per account.
PROMO_CODES=

# --- Payment gateway (tokenization happens in the browser, never on our server) ---
# Public/publishable key + gateway tokenization endpoint called from the browser.
PAYMENT_TOKENIZE_URL=http://localhost:4000/gateway/tokens
PAYMENT_PUBLIC_KEY=pk_test_dev
